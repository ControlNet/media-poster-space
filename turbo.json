{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "scripts/**"
  ],
  "tasks": {
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "lint",
        "^typecheck"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "typecheck",
        "^test"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "test",
        "^build"
      ],
      "env": [
        "MPS_WEB_BASE_PATH"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:release": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": []
    },
    "e2e": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "CI",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "cache": false
    },
    "e2e:web": {
      "dependsOn": [
        "build",
        "e2e"
      ],
      "env": [
        "CI",
        "MPS_GATE_FORCE_FAIL",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "cache": false
    },
    "e2e:desktop": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "CI",
        "MPS_GATE_FORCE_FAIL",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "cache": false
    }
  }
}
