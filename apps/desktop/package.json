{
  "name": "@mps/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "echo \"@mps/desktop lint placeholder\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:ui": "vite build --base ./",
    "build": "pnpm run build:ui",
    "tauri:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.conf.json",
    "e2e:desktop": "node ../../scripts/run-gates.mjs --platform desktop --metrics ../../.omo/evidence/task-16-desktop-gates.metrics.json -- vitest run --config vitest.gates.config.ts"
  },
  "dependencies": {
    "@mps/core": "workspace:*",
    "@tauri-apps/api": "~2.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.10",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
