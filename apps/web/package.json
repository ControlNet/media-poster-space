{
  "name": "@mps/web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "echo \"@mps/web lint placeholder\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "build:release": "node ../../scripts/release/package-web-release.mjs",
    "e2e": "playwright test --config=playwright.config.ts --project=web-chromium",
    "e2e:web": "node ../../scripts/run-gates.mjs --platform web --metrics ../../.omo/evidence/task-16-web-gates.metrics.json -- playwright test --config=playwright.config.ts --project=web-gates"
  },
  "dependencies": {
    "@mps/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
